{
  "name": "obsidian-movie-data",
  "version": "0.1.0",
  "description": "Obsidian plugin for managing movie and actor data",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "deploy:copy": "node scripts/deploy.mjs",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node test/live-e2e.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "movies"
  ],
  "license": "MIT",
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "jsdom": "^30.1.2",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
